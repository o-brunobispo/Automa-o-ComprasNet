// ==UserScript==
// @name         Preenchimento em Lote de Quantidades - Contratos.gov
// @namespace    http://tampermonkey.net/
// @version      1.2
// @description  Preenche as quantidades sequencialmente ou por pares (Item, Quantidade).
// @author       Você
// @match        https://contratos.comprasnet.gov.br/empenho/subelemento/*
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    $(document).ready(function() {

        // Cria a interface
        let container = $('<div style="margin-bottom: 20px; padding: 15px; background: #f4f4f4; border: 1px solid #ccc; border-radius: 5px;"></div>');
        let label = $('<strong>Preenchimento Rápido de Quantidades: </strong><br><small>Aperte <b>ENTER</b> dentro da caixa de texto para aplicar os valores.</small><br>');

        // Cria a chave (checkbox) para o modo Item/Quantidade
        let divModo = $('<div style="margin-top: 8px; margin-bottom: 8px;"></div>');
        let checkboxModo = $('<input type="checkbox" id="modoPar" style="margin-right: 5px; cursor: pointer;">');
        let labelModo = $('<label for="modoPar" style="cursor: pointer; font-weight: normal;">Ativar modo <b>Item, Quantidade</b> (Ex: 1, 50, 6, 30)</label>');
        divModo.append(checkboxModo).append(labelModo);

        let textarea = $('<textarea id="loteQtd" style="width: 100%; height: 80px; resize: vertical;" placeholder="Sequencial (Ex: 100, 200, 50)\n\nModo Item/Qtd (Ex: 1, 50, 6, 30)"></textarea>');

        // Insere tudo na página antes da tabela
        container.append(label).append(divModo).append(textarea);
        $('#dataTableBuilder').before(container);

        // Escuta a digitação
        textarea.on('keydown', function(e) {

            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();

                let texto = $(this).val();
                let valores = texto.split(/[\s,]+/).filter(val => val.trim() !== "");

                if (valores.length === 0) return;

                let isModoPar = $('#modoPar').is(':checked');
                let inputsQtd = $('.qtd');

                if (isModoPar) {
                    // MODO 2: Lê em pares [Item, Quantidade]
                    for (let i = 0; i < valores.length; i += 2) {
                        let numItemDesejado = parseInt(valores[i], 10);
                        let qtdDesejada = valores[i+1];

                        // Se faltar o par da quantidade no último item, interrompe para evitar erro
                        if (qtdDesejada === undefined) break;

                        // Procura o item correspondente na tabela
                        inputsQtd.each(function() {
                            // Pega o número do item na 3ª coluna visível da tabela (índice 2)
                            let textoNumeroItem = $(this).closest('tr').find('td').eq(2).text().trim();
                            let numItemAtual = parseInt(textoNumeroItem, 10);

                            // Se o item da linha for o mesmo que o digitado, preenche e calcula
                            if (numItemAtual === numItemDesejado) {
                                $(this).val(qtdDesejada);
                                $(this).trigger('input');
                            }
                        });
                    }
                } else {
                    // MODO 1: Sequencial (comportamento original)
                    inputsQtd.each(function(index) {
                        if (index < valores.length) {
                            $(this).val(valores[index]);
                            $(this).trigger('input');
                        }
                    });
                }

                // Feedback visual (pisca verde)
                let bgOriginal = $(this).css('background-color');
                $(this).css('background-color', '#d4edda');
                setTimeout(() => {
                    $(this).css('background-color', bgOriginal);
                }, 400);
            }
        });
    });
})();

// ==UserScript==
// @name         Automador de Seleção de Itens - Comprasnet Contratos v3.4
// @namespace    http://tampermonkey.net/
// @version      3.4
// @description  Extração precisa de itens do PDF baseada na tabela ITEM SRP.
// @author       Você
// @match        https://contratos.comprasnet.gov.br/empenho/item/*
// @grant        none
// @require      https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.min.js
// ==/UserScript==

(function() {
    'use strict';

    if (typeof pdfjsLib !== 'undefined') {
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/2.16.105/pdf.worker.min.js';
    }

    window.addEventListener('load', function() {
        const boxHeader = document.querySelector('.box.box-solid.box-primary .box-header');
        if (!boxHeader) return;

        const uploadContainer = document.createElement('div');
        uploadContainer.style.margin = '15px';
        uploadContainer.style.padding = '15px';
        uploadContainer.style.backgroundColor = '#f4f6f9';
        uploadContainer.style.border = '1px dashed #3c8dbc';
        uploadContainer.style.borderRadius = '5px';
        uploadContainer.innerHTML = `
            <label for="pdfRequisicaoFile" style="font-weight: bold; color: #333; cursor: pointer; display: block; margin-bottom: 8px;">
                <i class="fa fa-file-pdf-o" style="color: #dd4b39; font-size: 18px; margin-right: 5px;"></i>
                Automação por PDF (Requisição): Selecionar itens automaticamente (v3.4)
            </label>
            <input type="file" id="pdfRequisicaoFile" accept=".pdf" class="form-control" style="display: inline-block; width: auto; background: #fff;" />
            <span id="pdfStatus" style="margin-left: 10px; font-style: italic; color: #666;">Aguardando upload do PDF...</span>
        `;

        boxHeader.parentNode.insertBefore(uploadContainer, boxHeader.nextSibling);

        document.getElementById('pdfRequisicaoFile').addEventListener('change', async function(e) {
            const file = e.target.files[0];
            if (!file) return;

            const statusEl = document.getElementById('pdfStatus');
            statusEl.textContent = 'Lendo o PDF...';
            statusEl.style.color = '#f39c12';

            try {
                // 1. Extrair texto do PDF
                const arrayBuffer = await file.arrayBuffer();
                const loadingTask = pdfjsLib.getDocument({ data: arrayBuffer });
                const pdfDoc = await loadingTask.promise;

                let fullText = '';
                for (let i = 1; i <= pdfDoc.numPages; i++) {
                    const page = await pdfDoc.getPage(i);
                    const textContent = await page.getTextContent();
                    const pageText = textContent.items.map(item => item.str).join(' ');
                    fullText += pageText + '\n';
                }

                // Isolar apenas a área da tabela de itens (entre "ITEM SRP" e "Finalidade" ou "VALOR TOTAL")
                let tableArea = fullText;
                const startIdx = fullText.indexOf('ITEM SRP');
                const endIdx = fullText.indexOf('3. Finalidade') !== -1 ? fullText.indexOf('3. Finalidade') : fullText.indexOf('Finalidade');
                
                if (startIdx !== -1 && endIdx !== -1 && endIdx > startIdx) {
                    tableArea = fullText.substring(startIdx, endIdx);
                }

                statusEl.textContent = 'Carregando lista completa de itens do sistema...';

                // 2. Buscar TODOS os itens via API paginada
                const currentUrl = window.location.pathname;
                let allRows = [];
                let start = 0;
                let length = 100; 
                let hasMore = true;

                while (hasMore) {
                    const ajaxUrl = `${currentUrl}?draw=1&start=${start}&length=${length}`;
                    const response = await fetch(ajaxUrl, {
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json, text/javascript, */*; q=0.01'
                        }
                    });

                    if (!response.ok) break;
                    const jsonResponse = await response.json();
                    const rows = jsonResponse.data;

                    if (rows && Array.isArray(rows) && rows.length > 0) {
                        allRows = allRows.concat(rows);
                        if (rows.length < length || allRows.length >= (jsonResponse.recordsTotal || 0)) {
                            hasMore = false;
                        } else {
                            start += length;
                        }
                    } else {
                        hasMore = false;
                    }
                }

                // Mapeamento robusto de IDs
                const itensDisponiveis = {};
                allRows.forEach(row => {
                    const numClean = parseInt(row.numero, 10);
                    if (isNaN(numClean)) return;

                    let itemId = row.compra_item_id || row.id || row.item_id || row.id_item;

                    if (!itemId && row.action) {
                        const matchVal = row.action.match(/value=['"]?(\d+)['"]?/);
                        const matchId = row.action.match(/id=['"]?item_(\d+)['"]?/);
                        if (matchVal) itemId = matchVal[1];
                        else if (matchId) itemId = matchId[1];
                    }

                    if (itemId) {
                        itensDisponiveis[numClean] = String(itemId);
                        itensDisponiveis[String(numClean)] = String(itemId);
                    }
                });

                // 3. Extrair EXCLUSIVAMENTE os números de itens da tabela (número seguido de texto da descrição)
                const regexItemLinha = /\b(\d+)\s+[A-Za-zÀ-úÁ-ÿ]/g;
                const itensEncontradosInPdf = new Set();
                let match;

                while ((match = regexItemLinha.exec(tableArea)) !== null) {
                    const valNum = parseInt(match[1], 10);
                    if (itensDisponiveis[valNum]) {
                        itensEncontradosInPdf.add(valNum);
                    }
                }

                console.log('Itens corretos identificados no PDF:', Array.from(itensEncontradosInPdf));

                if (itensEncontradosInPdf.size === 0) {
                    statusEl.textContent = 'Nenhum item compatível foi encontrado no PDF.';
                    statusEl.style.color = '#dd4b39';
                    if (typeof Swal !== 'undefined') {
                        Swal.fire('Atenção', 'Nenhum item correspondente aos dados da página foi encontrado no PDF.', 'warning');
                    }
                    return;
                }

                let itensSelecionadosCount = 0;
                itensEncontradosInPdf.forEach(itemNum => {
                    const compraItemId = String(itensDisponiveis[itemNum]);

                    if (typeof arrItensASubmeter !== 'undefined' && !arrItensASubmeter.includes(compraItemId)) {
                        arrItensASubmeter.push(compraItemId);
                        itensSelecionadosCount++;
                    }

                    const checkbox = document.getElementById('item_' + compraItemId);
                    if (checkbox) {
                        checkbox.checked = true;
                    }
                });

                // Atualizar visualmente a tabela atual do DataTables
                if (typeof jQuery !== 'undefined' && jQuery('#dataTableBuilder').length) {
                    jQuery('#dataTableBuilder').DataTable().rows().every(function() {
                        const $node = jQuery(this.node());
                        const $chk = $node.find('input[type="checkbox"]');
                        if ($chk.length && arrItensASubmeter.includes($chk.val())) {
                            $chk.prop('checked', true);
                        }
                    });
                }

                statusEl.textContent = `Sucesso! ${itensSelecionadosCount} item(ns) selecionado(s) automaticamente (128, 129...).`;
                statusEl.style.color = '#00a65a';

                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'Itens Selecionados!',
                        text: `${itensSelecionadosCount} item(ns) da requisição em PDF foram selecionados com sucesso.`,
                        icon: 'success',
                        timer: 3500,
                        showConfirmButton: false
                    });
                }

            } catch (err) {
                console.error(err);
                statusEl.textContent = 'Erro ao processar: ' + err.message;
                statusEl.style.color = '#dd4b39';
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Erro', 'Não foi possível processar o arquivo PDF ou carregar os dados.', 'error');
                }
            }
        });
    });

})();

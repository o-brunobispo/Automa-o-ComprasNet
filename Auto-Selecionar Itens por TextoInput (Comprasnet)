// ==UserScript==
// @name         Auto-Selecionar Itens por Texto/Input (Comprasnet)
// @namespace    http://tampermonkey.net/
// @version      2.1
// @description  Permite digitar ou colar números separados por espaço, quebra de linha ou vírgula para seleção automática no Comprasnet
// @author       Você
// @match        https://contratos.comprasnet.gov.br/empenho/item/*
// @grant        none
// ==/UserScript==

(function() {
    'use strict';

    window.addEventListener('load', () => {
        injetarPainelInput();
    });

    function injetarPainelInput() {
        const boxTools = document.querySelector('.box-tools');
        if (!boxTools) return;

        const container = document.createElement('div');
        container.style.display = 'inline-block';
        container.style.marginRight = '10px';
        container.style.verticalAlign = 'middle';

        container.innerHTML = `
            <div style="display: inline-flex; gap: 5px; align-items: center;">
                <input type="text" id="inputItensManual" placeholder="Ex: 1, 4, 23 ou 1 4 23..." 
                       style="padding: 6px 10px; border: 1px solid #ccc; border-radius: 4px; width: 260px; font-size: 13px; background-color: #fff; color: #333;" 
                       title="Digite ou cole os números (separados por vírgula, espaço ou quebra de linha). Pressione Enter para executar.">
                <button type="button" id="btnExecutarSelecao" class="btn btn-primary" style="padding: 6px 12px;">
                    <i class="fa fa-check"></i> Selecionar
                </button>
            </div>
        `;

        boxTools.insertBefore(container, boxTools.firstChild);

        const inputEl = document.getElementById('inputItensManual');
        const btnEl = document.getElementById('btnExecutarSelecao');

        btnEl.addEventListener('click', processarSelecao);

        inputEl.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                processarSelecao();
            }
        });
    }

    function processarSelecao() {
        const inputEl = document.getElementById('inputItensManual');
        const texto = inputEl.value.trim();

        if (!texto) {
            alert('Por favor, digite ou cole pelo menos um número de item.');
            return;
        }

        // Divide o texto considerando espaços, quebras de linha E vírgulas
        const tokens = texto.split(/[\s,]+/);
        const itensDesejados = new Set();

        tokens.forEach(token => {
            const num = parseInt(token, 10);
            if (!isNaN(num) && num > 0) {
                itensDesejados.add(num);
            }
        });

        if (itensDesejados.size === 0) {
            alert('Nenhum número válido foi encontrado no campo.');
            return;
        }

        const scriptsHTML = document.documentElement.innerHTML;
        const fornecedoresMatch = scriptsHTML.match(/let fornecedores = (\[.*?\]);/);

        if (!fornecedoresMatch) {
            alert('Não foi possível localizar os dados dos fornecedores na página.');
            return;
        }

        const fornecedores = JSON.parse(fornecedoresMatch[1]);

        if (typeof arrItensASubmeter !== 'undefined') {
            arrItensASubmeter.length = 0;
        }
        document.querySelectorAll('input[type="checkbox"]').forEach(cb => {
            if (cb.id !== 'selectAll') cb.checked = false;
        });

        let selecionadosCount = 0;
        let naoEncontrados = [];

        itensDesejados.forEach(numDesejado => {
            let encontrado = false;

            fornecedores.forEach(forn => {
                const numItemPagina = parseInt(forn.numero, 10);
                if (numItemPagina === numDesejado) {
                    encontrado = true;
                    const itemIdStr = forn.compra_item_id.toString();

                    if (typeof arrItensASubmeter !== 'undefined' && !arrItensASubmeter.includes(itemIdStr)) {
                        if (typeof toggleItensASubmeter === 'function') {
                            toggleItensASubmeter(itemIdStr, true);
                        } else {
                            arrItensASubmeter.push(itemIdStr);
                        }

                        const checkboxVisual = document.querySelector(`input[value="${itemIdStr}"]`);
                        if (checkboxVisual) {
                            checkboxVisual.checked = true;
                        }

                        selecionadosCount++;
                    }
                }
            });

            if (!encontrado) {
                naoEncontrados.push(numDesejado);
            }
        });

        let mensagem = `Pronto! ${selecionadosCount} item(ns) selecionado(s) com sucesso.`;
        if (naoEncontrados.length > 0) {
            mensagem += `\n\nAviso: Os seguintes números digitados não pertencem a este contrato: ${naoEncontrados.join(', ')}`;
        }

        alert(mensagem);
    }
})();
